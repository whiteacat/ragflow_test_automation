ragflow:
  base_url: "http://127.0.0.1:9380"   # 本地 RAGFlow 地址，去掉尾部 /
  api_key: "ragflow-CHANGE_ME"          # 系统设置 > API Key
  dataset_ids: ["CHANGE_ME"]            # 至少一个 knowledge base ID
  chat_id: "CHANGE_ME"                  # Chat Assistant ID（问答/生成类指标用）
  timeout_s: 60

retrieval:
  page: 1
  page_size: 30        # 取回条数，建议 >=20 以计算 Top@20
  top_k: 1024
  similarity_threshold: 0.2
  vector_similarity_weight: 0.3
  keyword: false
  highlight: false
  rerank_id: null      # 如有 rerank 模型可填，否则 null

run:
  dataset: "datasets/golden_sample.jsonl"
  output_dir: "results"
  experiment_id: "exp_local_001"
  # 只跑检索（RAG-01~05/09/10）设为 true；跑全链路设为 false
  retrieval_only: false
  # QPS 限速，避免打爆本地模型
  qps: 2
  max_questions: null  # 调试时设小数字，如 5

judge:
  # 规则先行；LLM 评委仅用于 GEN-01/03/04/06/08、RAG-06/07 的半自动复核
  # 留空 = 跳过 LLM 复核，只出规则版结果 + 待人工复核队列
  mode: "off"          # off | openai_compatible
  base_url: null
  api_key: null
  model: null
