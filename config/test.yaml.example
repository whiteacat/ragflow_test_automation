ragflow:
  base_url: "http://127.0.0.1:9380"   # 本地 RAGFlow 地址，去掉尾部 /
  api_key: "ragflow-CHANGE_ME"          # 系统设置 > API Key
  dataset_ids: ["CHANGE_ME"]            # 至少一个 knowledge base ID
  chat_id: "CHANGE_ME"                  # Chat Assistant ID（问答/生成类指标用）
  timeout_s: 60

retrieval:
  page: 1
  page_size: 30        # 取回条数，建议 >=20 以计算 Top@20
  top_k: 1024
  similarity_threshold: 0.2
  vector_similarity_weight: 0.3
  keyword: false
  highlight: false
  # 重排模型 id：必须是 RAGFlow 里注册的“全限定引用” 模型名@实例名@provider名
  # 例：Qwen3-Reranker-8B@default@VLLM（vLLM 本地部署，实例名通常是 default）
  # 只写裸模型名会报 Provider  not found for model <名字>（provider 段为空）
  # 老版本（Python 后端）用 ___VLLM 后缀，不适用于新版；以 UI/DB 里查到的为准
  # 查法：Model providers 页，或 SELECT model_name/instance_name/provider_name 拼接
  rerank_id: null      # 没配 rerank 就留 null
  # §6.2 重排 A/B：填 [关闭值, 开启值] 即对同一批问题跑两次、同一候选集对比排序变化
  # 必须有一侧等于上面的 rerank_id，否则会被跳过。例：
  # rerank_compare: [null, "Qwen3-Reranker-8B@default@VLLM"]
  rerank_compare: null

parse:
  # §5 原文解析链路（独立于问答）：先 extract_docx_baseline 再 parse_benchmark
  baseline: "datasets/parse_baseline.jsonl"
  dataset_id: null     # 默认取 ragflow.dataset_ids[0]，此处可覆盖指定知识库
  document_id: null    # RAGFlow 侧 document_id（list_documents 获取后填入）

tier:
  # §10 三层集：core=全部专业审核（发布验收/回归）；extended=工具生成+抽查；adversarial=持续对抗
  active: "core"

run:
  dataset: "datasets/golden_sample.jsonl"
  # xlsx 全环节集：dataset 切到 datasets/xlsx_golden.jsonl，stages 选环节子集
  # 如 stages: ["retrieval", "rerank"]（留空/null 跑全部环节）
  stages: null
  output_dir: "results"
  experiment_id: "exp_local_001"
  # 只跑检索（RAG-01~05/09/10）设为 true；跑全链路设为 false
  retrieval_only: false
  # QPS 限速，避免打爆本地模型
  qps: 2
  max_questions: null  # 调试时设小数字，如 5

judge:
  # 规则先行；LLM 评委仅用于 GEN-01/03/04/06/08、RAG-06/07 的半自动复核
  # 留空 = 跳过 LLM 复核，只出规则版结果 + 待人工复核队列
  mode: "off"          # off | openai_compatible
  base_url: null
  api_key: null
  model: null
  # response_format: "json_object"  # Ollama/vLLM 强制 JSON 输出（Qwen3 思考模型建议开）

embedding:
  # 可选：本地 bge-m3 语义兜底。仅在「字面规则 + 二元组模糊」都没命中时才补漏，
  # 不会放宽任何已通过的判定；enabled=false 时所有指标与未引入 embedding 完全一致。
  enabled: false
  # openai = POST {base_url}/embeddings（vLLM / Ollama / TEI 的 OpenAI 兼容端点）
  # tei    = POST {base_url}/embed（HuggingFace text-embeddings-inference 原生接口）
  interface: "openai"
  # 例：vLLM   http://127.0.0.1:9997/v1
  #     Ollama http://127.0.0.1:11434/v1
  #     TEI    http://127.0.0.1:8080（interface 填 tei；其 OpenAI 兼容路径是 /v1）
  base_url: ""
  model: "bge-m3"
  api_key: ""                  # 也可用环境变量 EMBEDDING_API_KEY 覆盖
  dim: 1024                    # bge-m3 输出 1024 维，换模型时同步改
  timeout_s: 30
  batch_size: 32
  # 语义兜底阈值（余弦相似度），只补漏不覆盖规则命中；建议先用校准集验证再调
  fact_label_threshold: 0.75   # 事实标签 vs 答案单句
  evidence_threshold: 0.80     # 证据分句 vs TopK 内容单句
